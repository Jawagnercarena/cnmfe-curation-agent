# Per-machine path overrides for the CNMFe agent.
# Copy this file to ".env" (same folder) and edit. .env is gitignored.
# Anything left unset falls back to the defaults in local_config.py.

# Repo root (self-locates by default; usually leave unset).
# CNMFE_REPO_ROOT=C:\code\CNMF_E_LEGACY_BIANE_CLAUDE

# Parent folder holding one subdirectory per brain area (BLA/, vCA1/, ...).
CNMFE_DATA_PARENT=D:\Julian_CNMFe

# MATLAB executable (lab default is R2023b).
CNMFE_MATLAB_EXE=C:\Program Files\MATLAB\R2023b\bin\matlab.exe

# Python interpreter for subprocess calls (the 'valence' conda env).
CNMFE_PYTHON_EXE=C:\ProgramData\anaconda3\envs\valence\python.exe

# Lab-server exchange root for review-bundle distribution (W2).
# Set this on the central machine once you have the server path, e.g.:
# CNMFE_EXCHANGE_ROOT=\\labserver\share\cnmfe_exchange
CNMFE_EXCHANGE_ROOT=

# Results root of the retro_tdTomato_Alignment project; push_review_bundle.py
# adds a session's red_guide.png from there. Unset = this default; set it to
# nothing (CNMFE_RETRO_RESULTS=) to send no guides.
# CNMFE_RETRO_RESULTS=D:\retro_tdTomato_Alignment\results

# For pnb* sessions the push runs the retro project's guide-for-push hook, which
# builds or refreshes the guide (needs X: mapped in the shell running the push).
# Unset = on; 0 = do not build, only add a guide that already exists and matches.
# CNMFE_RETRO_GUIDE_BUILD=0
