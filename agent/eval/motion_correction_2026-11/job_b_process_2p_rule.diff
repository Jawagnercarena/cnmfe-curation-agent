+#!/usr/bin/env python
+"""
+Motion-correction rule for the 2p pipeline: a reference image at the field's
+usual position, a kept record of the shifts, and a QC line that can hold back
+the delete step. Driven by process_2p.py; nothing here runs on its own.
+
+Why (measured 2026-11 on pnb102 / pnb104, 6odorDualDiffRew):
+
+  - suite2p builds its reference image from 300 frames spread over the session.
+    In every session tested that reference sat 27-50 px away from where the
+    field usually is. Frames then need a shift larger than the search range
+    (maxregshift) and come out unregistered, and because suite2p shifts with
+    np.roll every large shift wraps a strip of image to the opposite edge.
+  - ops.npy, which holds the per-frame shifts, was deleted together with the
+    TSeries folder, so a bad session could not be diagnosed afterwards.
+
+What this module adds:
+
+  recentred_reference()  the reference rebuilt at the modal field position;
+                         process_2p.py hands it to suite2p (force_refImg).
+  save_record()          xoff / yoff / corrXY, reference, mean image and the
+                         settings, saved under <task dir>/mc_record/ BEFORE
+                         the TSeries folder is deleted.
+  qc()                   one row per session in <task dir>/mc_qc.csv; a session
+                         over the limits keeps its TSeries folder.
+
+The search range itself (maxregshift) is set in run_suite2p.REG_OVERRIDES.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import csv
+import io
+import time
+from pathlib import Path
+
+RECORD_DIR = "mc_record"
+QC_CSV = "mc_qc.csv"
+
+# Recentre only when the reference frames sit further than this from suite2p's
+# own reference; below it suite2p's reference is used unchanged.
+REF_MIN_OFFSET_PX = 5
+REF_DONE_PX = 2             # once recentring has started, stop within this
+REF_MAX_PASSES = 4
+REF_DROP_WORST_PCT = 10     # worst-correlated frames left out of the median
+REF_TOL_PX = (5, 10)        # frames this close to the median position are averaged
+REF_MIN_FRAMES = 15
+
+# QC limits. Starting values from 17 scored movies of which reviewers rejected
+# two (10.2% and 16.6% bad) and accepted the rest (up to 4.6% bad).
+QC_MAX_BAD = 0.05           # share of averaged frames far below the quiet level
+QC_MAX_AT_LIMIT = 0.01      # share of raw frames at the rigid search limit
+
+FFT_WORKERS = 8
+
+
+# --------------------------------------------------------------------------- #
+# reference image
+# --------------------------------------------------------------------------- #
+
+def reference_frames(session: Path, ops: dict):
+    """The frames suite2p takes for its reference, read straight from the tifs.
+
+    Same file order (natsorted), same frame indices (register.py:
+    linspace(0, n_frames, 1 + nimg_init)[:-1]) and same conversion
+    (io/tiff.py: uint16 -> // 2 -> int16) as suite2p, so the result is on the
+    scale of suite2p's binary. Returns (frames, indices, pages per file).
+    """
+    import numpy as np
+    import tifffile
+    from natsort import natsorted
+
+    files = natsorted(str(p) for p in session.glob("*.tif"))
+    npages = np.zeros(len(files), np.int64)
+    for i, name in enumerate(files):
+        with tifffile.TiffFile(name, is_ome=False) as tif:
+            npages[i] = len(tif.pages)
+    n_frames = int(npages.sum())
+    nimg = int(min(ops["nimg_init"], n_frames))
+    idx = np.linspace(0, n_frames, 1 + nimg, dtype=int)[:-1]
+    edges = np.concatenate([[0], np.cumsum(npages)])
+    file_of = np.searchsorted(edges, idx, side="right") - 1
+    page_of = idx - edges[file_of]
+    frames = None
+    for fi in np.unique(file_of):
+        with tifffile.TiffFile(files[fi], is_ome=False) as tif:
+            for k in np.where(file_of == fi)[0]:
+                im = tif.pages[int(page_of[k])].asarray()
+                if im.dtype.type == np.uint16:
+                    im = im // 2
+                if frames is None:
+                    frames = np.zeros((nimg,) + im.shape, np.int16)
+                frames[k] = im.astype(np.int16)
+    return frames, idx, npages
+
+
+def recentred_reference(session: Path, ops: dict) -> tuple[object, dict]:
+    """(refImg or None, info). None means: let suite2p build its own reference.
+
+    suite2p's reference from the reference frames -> rigid offsets of those
+    frames against it -> their median offset (where the field usually is) ->
+    average of the frames within a few px of that position, each rolled onto
+    it -> repeat against the new reference until the median offset is within
+    REF_DONE_PX.
+    """
+    import numpy as np
+    from suite2p.registration import register
+
+    info = {"recentred": False, "offset": [0, 0], "frames_used": 0, "note": ""}
+    if ops.get("force_refImg") and "refImg" in ops:
+        info["note"] = "reference supplied in the ops file"
+        return None, info
+    if ops.get("do_bidiphase") and not ops.get("bidiphase"):
+        # suite2p estimates the bidirectional phase only while building its own
+        # reference; forcing a reference would silently skip that estimate.
+        info["note"] = "do_bidiphase is on: suite2p's own reference kept"
+        return None, info
+    if ops.get("nplanes", 1) != 1 or ops.get("nchannels", 1) != 1:
+        info["note"] = "more than one plane or channel: suite2p's own reference kept"
+        return None, info
+
+    frames, idx, npages = reference_frames(session, ops)
+    info["npages"] = [int(n) for n in npages]
+    quiet = {**ops, "nonrigid": False, "reg_tif": False, "reg_tif_chan2": False}
+
+    def offsets(ref_img):
+        """Rigid (y, x) offset and correlation peak of every reference frame."""
+        with contextlib.redirect_stdout(io.StringIO()):
+            out = register.compute_reference_and_register_frames(
+                frames.copy(), f_align_out=np.zeros_like(frames),
+                refImg=ref_img, ops=quiet)
+        return [np.asarray(v) for v in out[4]]
+
+    with contextlib.redirect_stdout(io.StringIO()):
+        ref = register.compute_reference(frames.copy(), ops=ops)
+    y, x, c = offsets(ref)
+    total = [0, 0]
+    used = tol = 0
+    starved = False
+    for _ in range(REF_MAX_PASSES):
+        # All frames but the worst-correlated tenth (out-of-plane frames have
+        # meaningless offsets). Not "the best-correlated half": the correlation
+        # peak falls with the size of the shift, so the best half sits near the
+        # CURRENT reference and under-estimates how far off it is
+        # (090826-pnb104: +24 px in x from the best half, +47 px in truth).
+        keep = c >= np.percentile(c, REF_DROP_WORST_PCT)
+        my = int(np.round(np.median(y[keep])))
+        mx = int(np.round(np.median(x[keep])))
+        limit = REF_DONE_PX if total != [0, 0] else REF_MIN_OFFSET_PX
+        if max(abs(my), abs(mx)) <= limit:
+            break
+        for tol in REF_TOL_PX:
+            near = keep & (np.abs(y - my) <= tol) & (np.abs(x - mx) <= tol)
+            if near.sum() >= REF_MIN_FRAMES:
+                break
+        if near.sum() < 5:
+            starved = True
+            break
+        acc = np.zeros(ref.shape, np.float64)
+        for i in np.where(near)[0]:
+            acc += np.roll(frames[i], (-(int(y[i]) - my), -(int(x[i]) - mx)),
+                           axis=(0, 1))
+        ref = (acc / near.sum()).astype(np.int16)
+        used = int(near.sum())
+        total = [total[0] + my, total[1] + mx]
+        y, x, c = offsets(ref)
+
+    if total == [0, 0]:
+        info["offset"] = [my, mx]
+        info["note"] = ("too few frames near the median position: suite2p's "
+                        "own reference kept" if starved else
+                        "suite2p's reference is already at the median position")
+        return None, info
+    info["offset"] = total
+    info["recentred"] = True
+    info["frames_used"] = used
+    info["note"] = f"recentred from {used} frames within {tol} px"
+    return ref, info
+
+
+def apply_reference(session: Path, ops: dict) -> dict:
+    """Put the recentred reference (if one is needed) into ops, in place.
+
+    The outcome travels inside ops as ops["mc_reference"], so it ends up in
+    suite2p's ops.npy and the record and QC steps can read it back even when
+    registration and averaging happen in different runs.
+    """
+    ref, info = recentred_reference(session, ops)
+    if ref is not None:
+        ops["refImg"] = ref
+        ops["force_refImg"] = True
+    ops["mc_reference"] = info
+    return info
+
+
+# --------------------------------------------------------------------------- #
+# shift record
+# --------------------------------------------------------------------------- #
+
+RECORD_SETTINGS = ("maxregshift", "nonrigid", "block_size", "maxregshiftNR",
+                   "smooth_sigma", "smooth_sigma_time", "snr_thresh",
+                   "nimg_init", "batch_size", "two_step_registration",
+                   "th_badframes", "norm_frames", "force_refImg", "fs")
+
+
+def load_ops(session: Path, plane: int) -> dict:
+    import numpy as np
+
+    path = session / "suite2p" / f"plane{plane}" / "ops.npy"
+    return np.load(path, allow_pickle=True).item()
+
+
+def save_record(task_dir: Path, session: Path, out_tif: Path, plane: int) -> Path:
+    """Keep what the delete step would destroy. Never overwrites a record."""
+    import json
+
+    import numpy as np
+
+    ops = load_ops(session, plane)
+    ref_info = ops.get("mc_reference", {})
+    folder = task_dir / RECORD_DIR
+    folder.mkdir(exist_ok=True)
+    path = folder / f"{out_tif.stem}_mc.npz"
+    if path.exists():
+        path = folder / f"{out_tif.stem}_mc_{time.strftime('%Y%m%d-%H%M%S')}.npz"
+    settings = {k: ops.get(k) for k in RECORD_SETTINGS}
+    settings = {k: (v.tolist() if hasattr(v, "tolist") else v)
+                for k, v in settings.items()}
+    np.savez_compressed(
+        path,
+        yoff=np.asarray(ops["yoff"]), xoff=np.asarray(ops["xoff"]),
+        corrXY=np.asarray(ops["corrXY"]),
+        badframes=np.asarray(ops.get("badframes", [])),
+        refImg=np.asarray(ops["refImg"]), meanImg=np.asarray(ops["meanImg"]),
+        yrange=np.asarray(ops.get("yrange", [])),
+        xrange=np.asarray(ops.get("xrange", [])),
+        frames_per_file=np.asarray(ops.get("frames_per_file", [])),
+        settings=json.dumps(settings),
+        ref_recentred=bool(ref_info.get("recentred", False)),
+        ref_offset=np.asarray(ref_info.get("offset", [0, 0])),
+        ref_note=str(ref_info.get("note", "")),
+        session=session.name,
+    )
+    return path
+
+
+# --------------------------------------------------------------------------- #
+# QC
+# --------------------------------------------------------------------------- #
+
+def movie_quality(tif_path: Path, chunk: int = 256) -> tuple[float, float, float]:
+    """(bad, degraded, quiet r) of an averaged movie.
+
+    Each frame is band-passed (2-15 px) and correlated with the movie's own
+    template (mean of the better-correlated half of ~600 sampled frames, centre
+    crop). quiet = 90th percentile of that correlation; bad = share of frames
+    below 0.5 x quiet, degraded = below 0.75 x quiet. Same definition as r_raw
+    in ACORN's agent/eval/motion_correction_2026-11/motion_metrics.py.
+    """
+    import numpy as np
+    import tifffile
+    from scipy import fft as sfft
+
+    mov = tifffile.memmap(tif_path, mode="r")
+    nt, ly, lx = mov.shape
+    fy = np.fft.fftfreq(ly)[:, None].astype(np.float32)
+    fx = np.fft.rfftfreq(lx)[None, :].astype(np.float32)
+
+    def gauss(sigma: float):
+        return np.exp(-2.0 * (np.pi ** 2) * (sigma ** 2)
+                      * (fy ** 2 + fx ** 2)).astype(np.float32)
+
+    band = gauss(2.0) - gauss(15.0)
+    m = 48
+
+    def bandpass(x):
+        f = sfft.rfft2(x, workers=FFT_WORKERS)
+        return sfft.irfft2(f * band, s=(ly, lx), workers=FFT_WORKERS).astype(np.float32)
+
+    def pearson(a, t):
+        ac = a[:, m:-m, m:-m]
+        tc = t[m:-m, m:-m]
+        ac = ac - ac.mean(axis=(1, 2), keepdims=True)
+        tc = tc - tc.mean()
+        num = (ac * tc[None]).sum(axis=(1, 2))
+        den = np.sqrt((ac ** 2).sum(axis=(1, 2)) * (tc ** 2).sum())
+        return (num / np.maximum(den, 1e-12)).astype(np.float32)
+
+    samp = np.unique(np.linspace(0, nt - 1, min(nt, 600)).astype(int))
+    stack = np.empty((len(samp), ly, lx), np.float32)
+    for i, k in enumerate(samp):
+        stack[i] = mov[k]
+    stack = bandpass(stack)
+    r0 = pearson(stack, stack.mean(axis=0))
+    template = stack[r0 >= np.median(r0)].mean(axis=0)
+    del stack
+    r = np.zeros(nt, np.float32)
+    for a in range(0, nt, chunk):
+        b = min(nt, a + chunk)
+        r[a:b] = pearson(bandpass(np.asarray(mov[a:b], dtype=np.float32)), template)
+    quiet = float(np.percentile(r, 90))
+    return float((r < 0.5 * quiet).mean()), float((r < 0.75 * quiet).mean()), quiet
+
+
+def qc(task_dir: Path, session: Path, out_tif: Path, plane: int) -> dict:
+    """Measure one session, append the row to mc_qc.csv, return the row.
+
+    row["flag"] is empty for a clean session; otherwise it says which limit
+    was passed, and process_2p.py keeps the TSeries folder.
+    """
+    import numpy as np
+
+    ops = load_ops(session, plane)
+    ref_info = ops.get("mc_reference", {})
+    yoff = np.asarray(ops["yoff"], np.float64)
+    xoff = np.asarray(ops["xoff"], np.float64)
+    ly, lx = int(ops["Ly"]), int(ops["Lx"])
+    # suite2p's rigid search limit (rigid.phasecorr: lcorr)
+    limit = int(min(round(float(ops["maxregshift"]) * min(ly, lx)), min(ly, lx) // 2))
+    at_limit = float(((np.abs(yoff) >= limit - 1) | (np.abs(xoff) >= limit - 1)).mean())
+    bad, degraded, quiet = movie_quality(out_tif)
+
+    flags = []
+    if bad > QC_MAX_BAD:
+        flags.append(f"bad frames {100 * bad:.1f}% > {100 * QC_MAX_BAD:.0f}%")
+    if at_limit > QC_MAX_AT_LIMIT:
+        flags.append(f"frames at the search limit {100 * at_limit:.1f}% > "
+                     f"{100 * QC_MAX_AT_LIMIT:.0f}%")
+    npages = ref_info.get("npages")
+    if ref_info.get("recentred") and not np.array_equal(
+            np.asarray(npages), np.asarray(ops.get("frames_per_file", []))):
+        flags.append("reference built from a different frame list than suite2p read")
+
+    offset = ref_info.get("offset", [0, 0])
+    row = {
+        "date": time.strftime("%Y-%m-%d %H:%M"),
+        "session": session.name,
+        "raw_frames": int(ops["nframes"]),
+        "maxregshift": float(ops["maxregshift"]),
+        "limit_px": limit,
+        "ref_recentred": int(bool(ref_info.get("recentred", False))),
+        "ref_offset_y": int(offset[0]),
+        "ref_offset_x": int(offset[1]),
+        "at_limit_pct": round(100 * at_limit, 2),
+        "median_y": round(float(np.median(yoff)), 1),
+        "median_x": round(float(np.median(xoff)), 1),
+        "max_abs_shift": round(float(max(np.abs(yoff).max(), np.abs(xoff).max())), 1),
+        "corrXY_median": round(float(np.median(ops["corrXY"])), 4),
+        "bad_pct": round(100 * bad, 2),
+        "degraded_pct": round(100 * degraded, 2),
+        "quiet_r": round(quiet, 3),
+        "flag": "; ".join(flags),
+    }
+    path = task_dir / QC_CSV
+    new = not path.exists()
+    with open(path, "a", newline="", encoding="ascii") as fh:
+        writer = csv.DictWriter(fh, fieldnames=list(row))
+        if new:
+            writer.writeheader()
+        writer.writerow(row)
+    return row
