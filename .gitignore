# ===== CNMFe curation agent =====

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Machine-local config (copy agent/.env.example -> agent/.env)
agent/.env
.env

# Logs
agent/logs/

# Trained model artifacts — regenerated by training; snapshot via GitHub Releases
agent/model/**/*.joblib

# Raw imaging data / demo movies — never belong in the code repo
*.tif
*.tiff
*.avi

# CVX per-user license (machine-specific, generated by cvx_setup)
cvx/cvx_license.dat

# CVX commercial solvers (Gurobi / MOSEK) — large binaries with separate paid
# licenses; CNMFe runs on the bundled free SeDuMi / SDPT3 solvers instead.
cvx/gurobi/
cvx/mosek/

# Upstream demo data (not needed by the agent or the review workflow)
ca_source_extraction/demoMovie.mat

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/

# Claude Code personal/local settings (keep shared settings.json if present)
.claude/settings.local.json

# MATLAB GUI "last used data path" cache (machine-specific absolute path)
.dir.mat
